+        for row, t in zip(rows, D.crew_vote_turns(ev)):
+            sus = t["action"]["suspicion"]
+            truth = D.truth_for(ev, list(sus))
+            f = blind_jobw50_by_hand(ev, t)
+            fe = sum((f[n] - truth[n]) ** 2 for n in sus) / len(sus)
+            me = sum((sus[n] / 100 - truth[n]) ** 2 for n in sus) / len(sus)
+            self.assertAlmostEqual(row["formula"], fe, places=12)
+            self.assertAlmostEqual(row["player_error"], me, places=12)
+            self.assertAlmostEqual(row["detect"], fe - me, places=12)
+            self.assertEqual((row["model"], row["game"], row["rated"]), (t["model"], "n1", len(sus)))
+
+    def test_known_readers(self):
+        perfect = D.detect_score([with_readings(g, "perfect") for g in self.games])
+        for m, s in perfect["models"].items():
