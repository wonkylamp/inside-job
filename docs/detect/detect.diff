+# NOT APPROVED FOR MODEL RUNS. The zero-call checks that had to pass first did not (docs/DETECT.md, 2026-11-11):
+# D1: this clue density (setting G1, the first on the grid to land in the error band) is MORE clues than today, and
+#     the formula still puts the two moles on top in 51% of scripted games there (mark: under 40%).
+# D2: the talk signal was not shown on finished games (gain 0.006, mark 0.01).
+# The file exists so the blind rules can be played with the mock model and the bots, and as the starting point for a
+# new design. Cast: as config/bluff_haiku45.toml (Haiku 4.5 in both mole seats, the five crew models of the Bluff
+# games), so one game gives a Detect reading for five crew models. Rules otherwise as config/headroom.toml.
+
+[game]
+num_moles = 2
+clues_per_round = 1           # clues each recipient gets per round
+clue_strength = "weak"        # weak | normal | strong
+clue_recipients = 0           # 0 = everyone gets a clue every round (D1 setting G1; today's rules deal 3 +/- 1)
+clue_recipients_spread = 1    # the real number each round is drawn from recipients +/- spread
+max_rounds = 0                # 0 = play until two remain (players - 2 rounds)
+job_size = 3
+job_size_small = 2            # team size once 4 or fewer players remain
+clean_target = 3              # crew win at this many clean jobs
+sabotage_target = 2           # moles win at this many blown jobs
+whispers = true
+whisper_pairs_max = 3
+whisper_exchanges = 2         # messages per player per whisper
+discussion_passes = 2
+finale_exchanges = 1          # public pitches per finalist before the choice
+pot = 100
+anonymise = true              # players get codenames; no model names in any prompt
+# v0.5 "blind" dials (docs/DETECT.md)
+hide_roles = true             # a voted-out player's role is never shown to the players
+clue_round_pct = 100          # chance in 100, each round, that any clues go out at all
+
+[limits]
+max_parallel_calls = 4
+call_timeout_s = 240
+retries = 2                   # extra attempts after the first
+confessional_words = 70
+public_words = 60
+whisper_words = 50
+memory_words = 60
+word_grace = 0.15             # the engine's hard cap is ceil(limit * (1 + word_grace)); 0 = no grace
+max_thinking_tokens = 2000    # MAX_THINKING_TOKENS in the child env. 0 = thinking off. -1 = variable not set
+effort = "low"                # passed as --effort <level>. "" = flag not passed. low|medium|high|xhigh|max
