+"""Exploratory, run AFTER the D1 and D2 numbers were seen (2026-11-11, about 15:40 UTC). Decides nothing.
+Zero model calls. Usage: python3.11 explore_after.py <repo> <games dir>"""
+import copy, json, sys
+sys.path.insert(0, sys.argv[1])
+from inside_job import detect as D
+from inside_job.bots import play_bot_game
+from inside_job.config import config_from_dict, load_raw
+from inside_job.log import read_log
+
+raw = load_raw(sys.argv[1] + "/config/headroom.toml")
+seeds = range(D.D1_SEEDS[0], D.D1_SEEDS[1] + 1)
+out = {"d1_by_round": {}, "real": {}}
+print("A. D1 games split by the round of the last vote (error / top-two share / games)")
+for key, label, over in (("today", "today", D.TODAY),) + tuple((k, l, dict(o, hide_roles=True)) for k, l, o in D.GRID):
+    r = copy.deepcopy(raw); r["game"].update(over)
+    cfg = config_from_dict(r)
+    cells = [D.game_cell(play_bot_game(cfg, s, **D.BOT_POLICY)) for s in seeds]
+    row = {}
+    for rd in (1, 2, 3):
+        cs = [c for c in cells if c["round"] == rd]
+        row[rd] = {"games": len(cs), "error": sum(c["brier"] for c in cs) / len(cs), "solved": sum(c["solved"] for c in cs) / len(cs)}
+    out["d1_by_round"][key] = row
+    print(f"{key:<6}", "  ".join(f"R{rd}: {v['error']:.3f} / {100*v['solved']:4.1f}% / {v['games']:>3}" for rd, v in row.items()))
+
+print("\nB. The 75 finished real games (today's rules as played, and the same record masked), last vote of each game")
+man = json.load(open(sys.argv[1] + "/docs/DETECT_D2_GAMES.json"))
+for name, f in (("as played (roles revealed)", lambda ev: ev), ("masked (roles hidden)", D.mask_blind)):
+    cells = []
+    for g in man["games"]:
+        ev = f(read_log(f"{sys.argv[2]}/{g['game_id']}.jsonl"))
+        c = D.game_cell(ev); c["game"] = g["game_id"]; c["batch"] = g["batch"]; cells.append(c)
+    n = len(cells)
+    err = sum(c["brier"] for c in cells) / n; sol = sum(c["solved"] for c in cells) / n
+    ci = D._boot_mean([(c["game"], c["brier"]) for c in cells]); cs = D._boot_mean([(c["game"], c["solved"]) for c in cells])
+    rounds = {r: sum(c["round"] == r for c in cells) for r in sorted({c["round"] for c in cells})}
+    out["real"][name] = {"games": n, "error": err, "error_ci": ci, "solved": sol, "solved_ci": cs, "last_vote_round": rounds,
+                         "crew_win": sum(c["winner"] == "crew" for c in cells) / n}
+    print(f"{name:<28} games {n}  error {err:.4f} [{ci[0]:.3f}, {ci[1]:.3f}]  top two = moles {100*sol:.1f}% [{100*cs[0]:.1f}, {100*cs[1]:.1f}]  last-vote round {rounds}  crew win {100*out['real'][name]['crew_win']:.1f}%")
+    for b in ("pilot1", "pilot2", "bluff"):
+        cs2 = [c for c in cells if c["batch"].startswith(b) or (b == "bluff" and c["batch"] == "headroom1")]
+        print(f"    {b:<7} games {len(cs2)}  error {sum(c['brier'] for c in cs2)/len(cs2):.4f}  top two {100*sum(c['solved'] for c in cs2)/len(cs2):.1f}%")
+json.dump(out, open(sys.argv[1] + "/analysis/out/detect/detect_explore_after.json", "w"), indent=1)
