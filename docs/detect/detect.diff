+class ThinIntel(unittest.TestCase):
+    def test_zero_means_no_clue_is_ever_dealt(self):
+        cfg = make_config(clue_round_pct=0, sabotage_target=3)
+        for seed in (1, 2, 3):
+            game, llm = run_game(seed, cfg)
+            ev = game.log.events
+            self.assertEqual(ev[0]["rules_version"], "0.5")
+            self.assertTrue(all(e["k"] == 0 and e["recipients"] == [] for e in ev if e["type"] == "clue_deal"))
+            self.assertTrue(all(e["clue"]["kind"] == "none" for e in ev if e["type"] == "clue"))
+            self.assertTrue(all("No clues are dealt in this game" in c["system"] for c in llm.calls if c["player"]))
+            # Roles are still revealed: this dial alone hides nothing.
+            self.assertTrue(any("was thrown out and was" in c["prompt"] for c in llm.calls))
+            self.assertTrue(all("role_hidden" not in e for e in ev))
+
+    def test_share_of_rounds_with_clues_follows_the_dial(self):
+        for pct, lo, hi in ((50, 0.38, 0.62), (17, 0.08, 0.28), (83, 0.72, 0.93)):
+            cfg = blind_config(clue_round_pct=pct)
+            deals = [e for s in range(1, 81) for e in play_bot_game(cfg, s) if e["type"] == "clue_deal"]
+            share = sum(1 for e in deals if e["k"] > 0) / len(deals)
+            self.assertGreater(len(deals), 150)
+            self.assertTrue(lo < share < hi, (pct, share))
+            self.assertTrue(all(2 <= e["k"] <= 4 for e in deals if e["k"]))
+
+    def test_the_draw_has_its_own_stream_and_is_seeded(self):
+        cfg = blind_config(clue_round_pct=50)
+        a, b = play_bot_game(cfg, 9), play_bot_game(cfg, 9)
+        self.assertEqual([e for e in a if e["type"] == "clue_deal"], [e for e in b if e["type"] == "clue_deal"])
+        g = Game(cfg, BotLLM(cfg, 9), 9, game_id="b", clock=fixed_clock)
+        g.run()
+        rng = random.Random("9:intel")
+        want = [rng.random() * 100 < 50 for _ in range(g.round)]
+        self.assertEqual([e["k"] > 0 for e in g.log.events if e["type"] == "clue_deal"], want)
+
+    def test_the_rules_text_says_so(self):
+        game, llm = run_game(1, blind_config(clue_round_pct=67))
+        sysm = next(c["system"] for c in llm.calls if c["player"])
+        self.assertIn("Each round there is a 67 in 100 chance that any clues go out at all. When they do, "
+                      "between two and four of the players still in privately receive one clue", sysm)
+        self.assertIn("everyone else, and everyone in a round with no clues, is told \"No new intel this round.\"", sysm)
+        game, llm = run_game(1, blind_config(clue_round_pct=50, clue_recipients=0))
+        self.assertIn("When they do, every player privately receives one clue about the other players; in a round "
+                      "with no clues everyone is told", next(c["system"] for c in llm.calls if c["player"]))
