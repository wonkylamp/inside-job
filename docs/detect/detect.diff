+    @classmethod
+    def setUpClass(cls):
+        cls.mine = dump.play_all(detail=True)
+
+    def test_equal_to_the_digest_of_the_code_before_the_dials(self):
+        want = json.loads(FIXTURE.read_text())
+        self.assertEqual(sorted(self.mine), sorted(want))
+        for name, w in want.items():
+            got = {k: v for k, v in self.mine[name].items() if not k.endswith("_list")}
+            self.assertEqual(got, w, name)
+        self.assertGreater(sum(w.get("calls", 0) for w in want.values()), 900)       # prompts compared
+        self.assertGreater(sum(w["events"] for w in want.values()), 15000)           # log lines compared
+        self.assertGreater(sum(w["formula_turns"] for w in want.values()), 1500)     # formula calls compared
+
+    def test_same_games_in_an_untouched_copy_of_the_code(self):
+        base = baseline_root()
+        if base is None:
+            self.skipTest("no untouched copy of the code (set INSIDE_JOB_BASELINE to one)")
+        env = {k: v for k, v in os.environ.items() if k != "OPENROUTER_API_KEY"}
+        out = subprocess.run([sys.executable, "-B", str(Path(dump.__file__).resolve()), "--root", str(base),
+                              "--detail"], capture_output=True, text=True, env=env, cwd=str(base), timeout=600)
+        self.assertEqual(out.returncode, 0, out.stderr[-2000:])
+        theirs = json.loads(out.stdout)
+        # The other process really played with the other copy's code.
+        self.assertEqual(Path(theirs.pop("_code")), base / "inside_job")
+        self.assertNotEqual(base / "inside_job", Path(dump.code_dir()))
+        self.assertEqual(sorted(theirs), sorted(self.mine))
+        for name, t in theirs.items():
+            m = self.mine[name]
+            for key in ("event_list", "call_list"):
+                if key in t:
+                    self.assertEqual(len(m[key]), len(t[key]), f"{name}: number of {key}")
+                    diff = next((i for i, (a, b) in enumerate(zip(m[key], t[key])) if a != b), None)
+                    self.assertIsNone(diff, f"{name}: first difference in {key} at index {diff}")
+            self.assertEqual(m["formulas_sha256"], t["formulas_sha256"], name)
