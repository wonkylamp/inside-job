@@ -0,0 +1,655 @@
+"""Detect (Bench v2, Phase 6; docs/DETECT.md): the blind formula, the scripted tuning (D1), the
+no-model reader (D2) and the score (D3). No model is called; games are played by the scripted bots
+or the mock model, and the reader and the score are checked on made-up data with known answers.
+
+That the existing formulas return what they always did on games that reveal roles is pinned in
+`tests/test_v05.py` (the digest covers `probes.formulas` at every vote turn of 99 games).
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import math
+import random
+import tempfile
+import unittest
+from itertools import combinations
+from math import comb
+from pathlib import Path
+from unittest import mock
+
+from inside_job import detect as D
+from inside_job.bots import play_bot_game
+from inside_job.clues import card_as_clue, clue_is_true
+from inside_job.config import config_from_dict, load_raw
+from inside_job.log import visible_events
+from inside_job.probes import brier, formulas, vote_cutoff
+from inside_job.solver import from_log, inputs_from_view, player_worlds, table_posterior, table_worlds
+
+from helpers import ROOT, make_config, run_game, turns
+
+HEADROOM = ROOT / "config" / "headroom.toml"
+
+
+def flip_roles(events):
+    out = []
+    for e in events:
+        if e["type"] == "vote_result" and e.get("role"):
+            e = dict(e, role="crew" if e["role"] == "mole" else "mole")
+        out.append(e)
+    return out
+
+
+def blind_jobw50_by_hand(events, turn, q=0.5):
+    """The blind formula written out again from the raw log, sharing no code with the module:
+    every pair of players that could be the moles given what the voter may see without any role."""
+    start = events[0]
+    seats = events[1]["seats"]
+    p, r = turn["player"], turn["round"]
+    cut = min(e["seq"] for e in events if e["type"] == "turn" and e.get("turn_phase") == "vote" and e["round"] == r)
+    upto = [e for e in events if e["seq"] < cut]
+    own = [e["clue"] for e in upto if e["type"] == "clue" and e["player"] == p and e["clue"]["kind"] != "none"]
+    cards = []
+    for e in upto:
+        if e["type"] != "turn":
+            continue
+        cs = [(e["player"], card_as_clue(c)) for c in (e.get("action") or {}).get("clue_cards") or []]
+        if e["turn_phase"] == "discuss" or (e["turn_phase"] == "whisper" and e.get("partner") == p):
+            cards += cs
+    jobs = [(e["team"], e["sabotages"]) for e in upto if e["type"] == "job_result"]
+    gone = {e["eliminated"] for e in upto if e["type"] == "vote_result" and e.get("eliminated")}
+
+    def base(w):
+        return (p not in w and not (gone and w <= gone)
+                and all(sum(t in w for t in team) >= sab for team, sab in jobs))
+    pairs = [frozenset(c) for c in combinations(seats, start["config"]["game"]["num_moles"])]
+    fits = [w for w in pairs if base(w) and all(clue_is_true(c, w) for c in own)
+            and all(spk in w or clue_is_true(c, w) for spk, c in cards)]
+    use = fits or [w for w in pairs if base(w)]
+
+    def weight(w):
+        lk = 1.0
+        for team, sab in jobs:
+            k = sum(t in w for t in team)
+            lk *= comb(k, sab) * q ** sab * (1 - q) ** (k - sab)
+        return lk
+    ws = [weight(w) for w in use]
+    tot = sum(ws)
+    return {n: sum(x for w, x in zip(use, ws) if n in w) / tot for n in seats if n != p}
+
+
+def bot_games(n=12, first=500, **game):
+    cfg = config_from_dict(dict(load_raw(HEADROOM), game=dict(load_raw(HEADROOM)["game"], **game)))
+    return [play_bot_game(cfg, s, **D.BOT_POLICY) for s in range(first, first + n)]
+
+
+# --------------------------------------------------------------------------- the blind formula
+
+class BlindFormula(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.revealed = bot_games(16)                       # today's rules
+        cls.blind = bot_games(16, hide_roles=True)         # played blind
+
+    def test_mask_flags_every_ejection_and_changes_nothing_else(self):
+        for ev in self.revealed:
+            before = json.dumps(ev)
+            m = D.mask_blind(ev)
+            self.assertEqual(json.dumps(ev), before)                       # the input is untouched
+            self.assertEqual(len(m), len(ev))
+            for a, b in zip(ev, m):
+                if a["type"] == "vote_result":
+                    self.assertEqual(b, dict(a, role_hidden=True))
+                else:
+                    self.assertIs(a, b)
+            self.assertEqual(D.mask_blind(m), m)                           # masking twice = masking once
+        for ev in self.blind:
+            self.assertEqual(D.mask_blind(ev), ev)                         # a blind log is already masked
+
+    def test_existing_inputs_are_untouched_on_games_that_reveal_roles(self):
+        for ev in self.revealed:
+            for who in ("table", ev[1]["seats"][0]):
+                inp = from_log(ev, None, who)
+                self.assertEqual(sorted(inp), ["cards", "jobs", "num_moles", "own_clues", "pair_cards", "player",
+                                               "players", "revealed"])
+                self.assertEqual(len(inp["revealed"]), sum(1 for e in ev if e["type"] == "vote_result"))
+        # ... and the new argument's default is the old behaviour.
+        seats = list("ABCDEFG")
+        self.assertEqual(len(table_worlds(seats, 2, {}, [], [])), 21)
+        self.assertEqual(table_worlds(seats, 2, {"A": "crew"}, [], [], ()), table_worlds(seats, 2, {"A": "crew"}, [], []))
+
+    def test_masked_inputs_carry_no_role(self):
+        for ev in self.revealed:
+            m = D.mask_blind(ev)
+            out = [e["eliminated"] for e in ev if e["type"] == "vote_result"]
+            for who in ("table", ev[1]["seats"][0]):
+                inp = from_log(m, None, who)
+                self.assertEqual(inp["revealed"], {})
+                self.assertEqual(inp["hidden_out"], out)
+
+    def test_only_fact_taken_from_the_voted_out_is_that_a_mole_is_still_in(self):
+        seats = list("ABCDEFG")
+        all_pairs = table_worlds(seats, 2, {}, [], [])
