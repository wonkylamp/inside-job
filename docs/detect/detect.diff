+from helpers import (ROOT, Script, fixed_clock, job_choice, make_config, pick_without_moles, raw_default,
+                     run_game, turns, vote_moles, vote_with)
+
+FIXTURE = Path(__file__).resolve().parent / "fixtures" / "v05_defaults" / "digest.json"
+# What a prompt would say if it gave a voted-out player's role or the number of moles left away.
+LEAK = re.compile(r"was a mole|was crew\b|revealed as|Moles still in: \d|(One|Two|Three) moles? (is|are) still in|"
+                  r"role is revealed|what has been revealed|the revealed roles")
+
+
+def blind_config(**game):
+    return make_config(**dict({"hide_roles": True, "sabotage_target": 2}, **game))
+
+
+def flip_roles(events):
+    """The same log with every voted-out player's logged role swapped (mole <-> crew)."""
+    out = []
+    for e in events:
+        if e["type"] == "vote_result" and e.get("role"):
+            e = dict(e, role="crew" if e["role"] == "mole" else "mole")
+        out.append(e)
+    return out
+
+
+def baseline_root() -> Path | None:
+    """An untouched copy of the code to compare with: $INSIDE_JOB_BASELINE, or a folder `orig`
+    beside this copy."""
+    env = os.environ.get("INSIDE_JOB_BASELINE")
+    for cand in ([Path(env)] if env else []) + [ROOT.parent / "orig"]:
+        if (cand / "inside_job" / "engine.py").exists() and (cand / "config" / "default.toml").exists():
+            return cand.resolve()
+    return None
