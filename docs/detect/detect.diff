+        self.assertIn("beats the formula", D.detect_markdown(perfect))
+        self.assertIn("not separated from the formula", D.detect_markdown(same))
+        self.assertIn("worse than the formula", D.detect_markdown(wrong))
+
+    def test_interval_is_over_games(self):
