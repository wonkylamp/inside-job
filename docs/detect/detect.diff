+def with_readings(events, how):
+    """A copy of a game in which every crew vote turn's logged suspicion is replaced by `how`."""
+    out = copy.deepcopy(events)
+    role = D.roles_of(out)
+    for t in D.crew_vote_turns(out):
+        sus = t["action"]["suspicion"]
+        f = D.formula_at_vote(events, t, list(sus))
+        for n in sus:
+            truth = int(role[n] == "mole")
+            sus[n] = {"perfect": 100 * truth, "formula": round(100 * f[n]), "wrong": 100 * (1 - truth),
+                      "flat": 33}[how]
+    return out
+
