--- orig/tests/dump_default_play.py	1970-01-01 01:00:00
+++ repo/tests/dump_default_play.py	2026-11-11 15:28:46
@@ -0,0 +1,121 @@
+"""Digest of default play, for the "dials off change nothing" test (tests/test_v05.py, docs/DETECT.md).
+
+    python3.11 tests/dump_default_play.py [--root COPY] [--detail] > digest.json
+
+`--root` is the folder holding the `inside_job` package and `config/` to play with (default: the
+folder this file's `tests/` sits in), so one copy of this script can drive two copies of the code.
+
+It plays seeded games with the mock model (which records every prompt it is sent) and with the
+scripted bots, using only code that exists both before and after the v0.5 "blind" dials, and prints
+one JSON object: for each game, the number of model calls and log lines and a SHA-256 over all of
+them; with `--detail`, also one SHA-256 per call and per log line, so the first difference can be
+named. It also hashes what `probes.formulas` returns at every vote turn of every game. A call is hashed over model, system prompt, turn prompt, reply schema (key order kept), phase
+and player. A log line is hashed as the JSON the engine writes.
+
+Fields left out, because they are expected to differ between two runs or two copies of the code:
+`wall_s` (game_end: how long the game took), and `code_hash` / `code_files` (game_start: the stamp
+over the source files, which differs whenever a source file does; written only in the one game here
+that asks for a stamp). `ts` and `game_id` are not left out: the clock and the id are fixed.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+ROOT = (Path(sys.argv[sys.argv.index("--root") + 1]).resolve() if "--root" in sys.argv
+        else Path(__file__).resolve().parent.parent)
+sys.path.insert(0, str(ROOT))
+
+from inside_job.bots import BotLLM                      # noqa: E402
+from inside_job.config import load_config               # noqa: E402
+from inside_job.engine import Game                      # noqa: E402
+from inside_job.llm import MockLLM                      # noqa: E402
+from inside_job.probes import formulas, vote_cutoff     # noqa: E402
+from inside_job.rawlog import code_fingerprint          # noqa: E402
+
+DROP_EVENT = ("wall_s", "code_hash", "code_files")
+MOCK = (("default", (1, 2, 3)), ("pilot2", (1, 2, 3)), ("bluff_haiku45", (101, 102)))
+BOTS = (("default", "smart", range(1, 31)), ("default", "always", range(1, 11)),
+        ("default", "never", range(1, 11)), ("pilot2", "smart", range(1, 31)),
+        ("pilot2", "hold1", range(1, 11)))
+CLOCK = "2026-01-01T00:00:00.000Z"
+
+
+def sha(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def event_line(e: dict) -> str:
+    return json.dumps({k: v for k, v in e.items() if k not in DROP_EVENT}, ensure_ascii=False)
+
+
+def call_line(c: dict) -> str:
+    return "\x00".join((c["model"], c["system"], c["prompt"], json.dumps(c["schema"], ensure_ascii=False),
+                        str(c["phase"]), str(c["player"])))
+
+
+def formula_lines(events: list[dict]) -> list[str]:
+    """What the existing formulas return at every vote turn of the game (every voter, crew or mole,
+    rating every other player at the table), as sorted JSON: the v0.5 work must not change it."""
+    seats = events[1]["seats"]
+    out = []
+    for t in events:
+        if t["type"] == "turn" and t.get("turn_phase") == "vote":
+            rated = [n for n in seats if n != t["player"]]
+            f = formulas(events, vote_cutoff(events, t["round"]), t["player"], rated)
+            out.append(json.dumps({"seq": t["seq"], "f": f}, sort_keys=True))
+    return out
+
+
+def digest(events: list[dict], calls: list[dict] | None, detail: bool) -> dict:
+    ev = [sha(event_line(e)) for e in events]
+    fl = formula_lines(events)
+    out = {"events": len(ev), "events_sha256": sha("\n".join(ev)),
+           "formula_turns": len(fl), "formulas_sha256": sha("\n".join(fl))}
+    if calls is not None:
+        cs = [sha(call_line(c)) for c in calls]
+        out.update(calls=len(cs), calls_sha256=sha("\n".join(cs)))
+    if detail:
+        out["event_list"] = ev
+        if calls is not None:
+            out["call_list"] = cs
+    return out
+
+
+def play_all(detail: bool = False) -> dict:
+    out = {}
+    for name, seeds in MOCK:
+        cfg = load_config(ROOT / "config" / f"{name}.toml")
+        for s in seeds:
+            llm = MockLLM(s)
+            g = Game(cfg, llm, s, game_id=f"fx-{name}-s{s}", clock=lambda: CLOCK)
+            g.run()
+            out[f"mock {name} s{s}"] = digest(g.log.events, llm.calls, detail)
+    # One game with the code stamp asked for, as `run` / `batch` do: only the stamp may differ.
+    cfg = load_config(ROOT / "config" / "pilot2.toml")
+    llm = MockLLM(7)
+    g = Game(cfg, llm, 7, game_id="fx-stamped-s7", clock=lambda: CLOCK, batch="fx", provenance=code_fingerprint())
+    g.run()
+    out["mock pilot2 s7 stamped"] = digest(g.log.events, llm.calls, detail)
+    for name, moles, seeds in BOTS:
+        cfg = load_config(ROOT / "config" / f"{name}.toml")
+        for s in seeds:
+            llm = BotLLM(cfg, s, crew="logician", crew_skill=0.7, moles=moles, mole_cards="decoy")
+            g = Game(cfg, llm, s, game_id=f"fx-bot-{name}-{moles}-s{s}", clock=lambda: CLOCK)
+            g.run()
+            out[f"bots {name} {moles} s{s}"] = digest(g.log.events, None, detail)
+    return out
+
+
+def code_dir() -> str:
+    """Where the `inside_job` package that played these games was loaded from."""
+    import inside_job
+    return str(Path(inside_job.__file__).resolve().parent)
+
+
+if __name__ == "__main__":
+    json.dump(dict(play_all("--detail" in sys.argv[1:]), _code=code_dir()), sys.stdout, indent=0, sort_keys=True)
+    sys.stdout.write("\n")
