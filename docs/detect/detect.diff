+    def test_bots_use_only_that_a_mole_is_still_in(self):
+        """A crew bot's belief on a blind table never puts both moles among the voted-out players."""
+        from inside_job.solver import inputs_from_view, player_worlds
+        cfg = blind_config()
+        n = 0
+        for seed in range(1, 31):
+            ev = play_bot_game(cfg, seed)
+            crew = next(q["name"] for q in ev[0]["players"] if q["role"] == "crew")
+            last = max(e["seq"] for e in ev if e["type"] == "round_start")
+            inp = inputs_from_view(visible_events([e for e in ev if e["seq"] <= last], crew), crew)
+            if len(inp.get("hidden_out", [])) < 2:
+                continue
+            self.assertEqual(inp["revealed"], {})
+            with_rule = player_worlds(inp["players"], 2, {}, [], inp["jobs"], player=crew, hidden_out=inp["hidden_out"])
+            without = player_worlds(inp["players"], 2, {}, [], inp["jobs"], player=crew)
+            gone = set(inp["hidden_out"])
+            self.assertTrue(all(not w <= gone for w in with_rule))
+            self.assertEqual(set(without) - set(with_rule), {w for w in without if w <= gone})
+            n += 1
+        self.assertGreater(n, 5)
