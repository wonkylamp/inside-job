+def made_up_rows(n_games=30, signal=1.5, seed=1, noise_cols=None):
+    """Rows as `reader_rows` gives them, from a known rule: the formula's chance f is honest but
+    blunt, and one talk feature (acc_now) carries `signal` more log-odds about the truth."""
+    rng = random.Random(seed)
+    k = len(D.READER_FEATURES)
+    rows = []
+    for g in range(n_games):
+        for turn in range(8):
+            for target in range(5):
+                f = rng.choice([0.1, 0.2, 0.33, 0.5, 0.67])
+                talk = rng.gauss(0, 1)
+                p = 1 / (1 + math.exp(-(D.logit(f) + signal * talk)))
+                x = [D.logit(f)] + [rng.gauss(0, 1) for _ in range(k - 1)]
+                x[1] = talk
+                rows.append({"game": f"g{g}", "group": f"s{g // 2}", "turn": (f"g{g}", turn), "round": 1 + turn % 3,
+                             "viewer": "v", "target": str(target), "f": f, "y": int(rng.random() < p), "x": x})
+    return rows
+
+
+class Reader(unittest.TestCase):
+    def test_logistic_recovers_a_known_rule_and_drops_a_constant_column(self):
+        rng = random.Random(4)
+        X, y = [], []
+        for _ in range(4000):
+            a, b = rng.gauss(2, 3), rng.gauss(-1, 0.5)
+            X.append([a, 7.0, b])
+            y.append(int(rng.random() < 1 / (1 + math.exp(-(0.4 + 0.5 * (a - 2) / 3 - 1.2 * (b + 1) / 0.5)))))
+        m = D.fit_logistic(X, y, l2=1e-9)
+        self.assertEqual(sorted(m["coef"]), [0, 2])
+        self.assertAlmostEqual(m["intercept"], 0.4, delta=0.12)
+        self.assertAlmostEqual(m["coef"][0], 0.5, delta=0.12)
+        self.assertAlmostEqual(m["coef"][2], -1.2, delta=0.15)
+        # At the solution the gradient of the (barely penalised) loss is zero.
+        ps = [D.predict(m, x) for x in X]
+        self.assertAlmostEqual(sum(p - t for p, t in zip(ps, y)), 0.0, delta=1e-5)
+        self.assertAlmostEqual(sum((p - t) * x[0] for p, t, x in zip(ps, y, X)), 0.0, delta=1e-3)
+        # The ridge penalty pulls coefficients towards zero, never the intercept's sign.
+        big = D.fit_logistic(X, y, l2=5000.0)
+        self.assertLess(abs(big["coef"][2]), abs(m["coef"][2]) / 2)
+        self.assertEqual(D.fit_logistic(X, y), D.fit_logistic(X, y))
+
+    def test_separable_data_does_not_blow_up(self):
+        X = [[float(i)] for i in range(-10, 11) if i]
+        y = [int(x[0] > 0) for x in X]
+        m = D.fit_logistic(X, y)
+        self.assertTrue(math.isfinite(m["coef"][0]) and m["coef"][0] > 0)
+        self.assertGreater(D.predict(m, [5.0]), 0.75)      # the ridge penalty keeps it from running to 1
+        self.assertLess(D.predict(m, [-5.0]), 0.25)
+
