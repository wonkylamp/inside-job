@@ -0,0 +1,794 @@
+"""Detect (Bench v2, Phase 6): does a player find the moles better than the no-model formula, on
+rules where the formula cannot solve the game? Design: docs/DETECT.md. Everything fixed before the
+numbers: docs/DETECT_RULES.md (hashed). Pass marks: docs/ANALYSIS.md, D1 to D3.
+
+Standard library only, and no model call anywhere in this file.
+
+- `mask_blind`: a finished game's record with the voted-out roles hidden, exactly as a v0.5
+  `hide_roles` game logs them (the flag `role_hidden`; `log.project` then shows the role to nobody).
+- The blind formula is `probes.formulas` on such a record: `jobw50` from a crew member's own view,
+  with no revealed role. `probes.formulas` is unchanged on every record that reveals roles.
+- D1 (`d1_walk`): scripted-player games down a clue-density grid; the formula's error at the last
+  vote of each game.
+- D2 (`d2_run`): a fixed no-model reader (logistic regression on the formula's log-odds plus the
+  listed talk features), tested leave-one-game-out on finished games with the record masked.
+- D3 (`detect_score`): Detect = formula's error minus the player's error on the same vote turns,
+  new-rules games only, interval over games.
+
+Truth (who is a mole) is always read from the engine's `game_start` event, never inferred.
+"""
+
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import json
+import math
+import re
+import sys
+from pathlib import Path
+
+from .config import config_from_dict, load_raw
+from .log import read_log, visible_events
+from .probes import BOOT_N, BOOT_SEED, bootstrap, brier, formulas, paired, stated, vote_cutoff
+
+# --------------------------------------------------------------------------- fixed in DETECT_RULES.md
+
+BAND = (0.09, 0.13)               # D1: the formula's mean error at the last vote must land here
+SOLVED_MARK = 0.40                # D1: "no longer solves it" = top two are the two moles in under 40%
+MARGIN = 0.01                     # D2: the reader must beat the masked formula by at least this
+D1_SEEDS = (150001, 150200)       # first and last of the 200 scripted-player seeds
+BOT_POLICY = {"crew": "logician", "crew_skill": 0.7, "moles": "smart", "mole_cards": "decoy"}
+# The clue-density grid, most clues first. Every setting also has hide_roles = true.
+GRID = (
+    ("G1", "everyone, every round", {"clue_recipients": 0, "clue_round_pct": 100}),
+    ("G2", "4 to 6 players, every round", {"clue_recipients": 5, "clue_recipients_spread": 1, "clue_round_pct": 100}),
+    ("G3", "3 to 5 players, every round", {"clue_recipients": 4, "clue_recipients_spread": 1, "clue_round_pct": 100}),
+    ("G4", "2 to 4 players, every round (today's density)",
+     {"clue_recipients": 3, "clue_recipients_spread": 1, "clue_round_pct": 100}),
+    ("G5", "2 to 4 players, 83 rounds in 100", {"clue_recipients": 3, "clue_recipients_spread": 1, "clue_round_pct": 83}),
+    ("G6", "2 to 4 players, 67 rounds in 100", {"clue_recipients": 3, "clue_recipients_spread": 1, "clue_round_pct": 67}),
+    ("G7", "2 to 4 players, 50 rounds in 100", {"clue_recipients": 3, "clue_recipients_spread": 1, "clue_round_pct": 50}),
+    ("G8", "2 to 4 players, 33 rounds in 100", {"clue_recipients": 3, "clue_recipients_spread": 1, "clue_round_pct": 33}),
+    ("G9", "2 to 4 players, 17 rounds in 100", {"clue_recipients": 3, "clue_recipients_spread": 1, "clue_round_pct": 17}),
+    ("G10", "no clues at all", {"clue_recipients": 3, "clue_recipients_spread": 1, "clue_round_pct": 0}),
+)
+TODAY = {"hide_roles": False, "clue_recipients": 3, "clue_recipients_spread": 1, "clue_round_pct": 100}
+
+# D2: the reader. `lo` is the masked formula's log-odds; the rest are the talk features.
+TALK_FEATURES = ("acc_now", "acc_before", "votes_before", "challenged_now", "accuses_viewer", "target_f",
+                 "cards_now", "claim_helped", "claim_silent", "words_now", "mentions_now", "whispered")
+READER_FEATURES = ("lo",) + TALK_FEATURES
+CLIP = (0.02, 0.98)               # the formula's chance is clipped to this before taking log-odds
+L2 = 1.0                          # ridge penalty on the standardised coefficients (not the intercept)
+NEWTON_STEPS, NEWTON_TOL = 50, 1e-8
+D2_BATCHES = ("pilot1", "pilot2", "headroom1", "bluff_haiku45", "bluff_opus55", "bluff_fable52", "bluff_sonnet55")
+FALLBACK_LIMIT = 0.05             # ANALYSIS.md, general rules: above this share a player is not scored
+
+
+# --------------------------------------------------------------------------- the blind record
+
+def start_of(events: list[dict]) -> dict:
+    return next(e for e in events if e["type"] == "game_start")
+
+
+def roles_of(events: list[dict]) -> dict:
+    """name -> "mole" | "crew", from the engine's own record of the deal."""
+    return {q["name"]: q["role"] for q in start_of(events)["players"]}
+
+
+def is_blind(events: list[dict]) -> bool:
+    """Was this game played with the voted-out roles hidden (v0.5 `hide_roles`)?"""
+    return bool(start_of(events)["config"]["game"].get("hide_roles"))
+
+
+def mask_blind(events: list[dict]) -> list[dict]:
+    """The record of a finished game as the blind rules would have shown it to the players: every
+    `vote_result` that threw somebody out gets the flag `role_hidden`, the flag a `hide_roles`
+    game writes. Everything a player (or the formula) is shown goes through `log.project`, which
+    then leaves the role out. Nothing else is touched; the input is not modified. Masking a
+    record that is already blind changes nothing."""
+    out = []
+    for e in events:
+        if e.get("type") == "vote_result" and e.get("eliminated") and not e.get("role_hidden"):
+            e = dict(e, role_hidden=True)
+        out.append(e)
+    return out
+
+
+def crew_vote_turns(events: list[dict], rnd: int | None = None) -> list[dict]:
+    """Vote turns by crew members (every one, fallback turns included), in log order."""
+    role = roles_of(events)
+    return [e for e in events if e["type"] == "turn" and e.get("turn_phase") == "vote"
+            and role.get(e["player"]) == "crew" and (rnd is None or e["round"] == rnd)]
+
+
+def alive_at(events: list[dict], rnd: int) -> list[str]:
+    return list(next(e for e in events if e["type"] == "round_start" and e["round"] == rnd)["alive"])
+
+
+def formula_at_vote(events: list[dict], turn: dict, rated: list[str] | None = None) -> dict:
+    """`jobw50` from the voter's own view just before the round's votes, for `rated` (default:
+    the other players still in). On a blind or masked record this is the blind formula."""
+    p, r = turn["player"], turn["round"]
+    if rated is None:
+        rated = [n for n in alive_at(events, r) if n != p]
+    return formulas(events, vote_cutoff(events, r), p, rated)["jobw50"]
+
+
+def truth_for(events: list[dict], names) -> dict:
+    role = roles_of(events)
+    return {n: int(role[n] == "mole") for n in names}
+
+
+# --------------------------------------------------------------------------- D1: scripted tuning
+
+def last_vote_round(events: list[dict]) -> int | None:
+    rounds = [e["round"] for e in events if e["type"] == "turn" and e.get("turn_phase") == "vote"]
+    return max(rounds) if rounds else None
+
+
+def top_two_are_moles(chances: dict, moles: set, tol: float = 1e-12) -> bool:
+    """Do the two moles both rate strictly above every other player? `chances` covers every other
+    player at the table, in or out."""
+    low = min(chances[m] for m in moles)
+    return all(chances[n] < low - tol for n in chances if n not in moles)
+
+
+def last_vote_rows(events: list[dict]) -> list[dict]:
+    """One row per crew voter at the last vote of the game: the formula's error on the players
+    still in, and whether its two highest-rated players (of all six others) are the two moles."""
+    r = last_vote_round(events)
+    if r is None:
+        return []
+    role = roles_of(events)
+    seats = [q["name"] for q in sorted(start_of(events)["players"], key=lambda q: q["seat"])]
+    moles = {n for n in seats if role[n] == "mole"}
+    cutoff = vote_cutoff(events, r)
+    rows = []
+    for t in crew_vote_turns(events, r):
+        p = t["player"]
+        everyone = [n for n in seats if n != p]
+        f_all = formulas(events, cutoff, p, everyone)["jobw50"]
+        rated = [n for n in alive_at(events, r) if n != p]
+        f = {n: f_all[n] for n in rated}
+        rows.append({"player": p, "round": r, "brier": brier(f, truth_for(events, rated)),
+                     "solved": top_two_are_moles(f_all, moles)})
+    return rows
+
+
+def game_cell(events: list[dict]) -> dict:
+    """The per-game figures D1 averages: mean error and share of crew voters whose formula has the
+    two moles on top, at the last vote; and the same question for the table's public view."""
+    rows = last_vote_rows(events)
+    r = rows[0]["round"]
+    role = roles_of(events)
+    moles = {n for n, x in role.items() if x == "mole"}
+    from .solver import from_log, table_posterior
+    public = table_posterior(from_log(events, vote_cutoff(events, r), "table"))
+    end = events[-1]
+    return {"seed": start_of(events).get("seed"), "voters": len(rows), "round": r,
+            "brier": sum(x["brier"] for x in rows) / len(rows),
+            "solved": sum(x["solved"] for x in rows) / len(rows),
+            "solved_all": all(x["solved"] for x in rows), "solved_any": any(x["solved"] for x in rows),
+            "solved_public": top_two_are_moles({n: public[n] for n in role}, moles),
+            "winner": end.get("winner"), "rounds": end.get("rounds")}
+
+
+def _mean(xs):
+    xs = list(xs)
+    return sum(xs) / len(xs) if xs else None
+
+
+def _boot_mean(pairs: list[tuple]) -> tuple | None:
+    """95% percentile interval of the mean, resampling whole games (2,000 draws, seed 20261110)."""
+    return bootstrap(pairs, _mean, BOOT_N, BOOT_SEED)
+
+
+def d1_cell(raw: dict, overrides: dict, seeds, bot_kw: dict | None = None) -> dict:
+    """Play one scripted-player game per seed under `raw` with `[game]` overrides; D1's figures."""
+    from .bots import play_bot_game
+    r = copy.deepcopy(raw)
+    r.setdefault("game", {}).update(overrides)
+    cfg = config_from_dict(r)
+    kw = dict(BOT_POLICY, **(bot_kw or {}))
+    games = [game_cell(play_bot_game(cfg, s, **kw)) for s in seeds]
+    n = len(games)
+    out = {"games": n, "voters": sum(g["voters"] for g in games),
+           "brier": _mean(g["brier"] for g in games),
+           "brier_ci": _boot_mean([(g["seed"], g["brier"]) for g in games]),
+           "solved": _mean(g["solved"] for g in games),
+           "solved_ci": _boot_mean([(g["seed"], g["solved"]) for g in games]),
+           "solved_all": sum(g["solved_all"] for g in games) / n,
+           "solved_any": sum(g["solved_any"] for g in games) / n,
+           "solved_public": sum(g["solved_public"] for g in games) / n,
+           "crew_win": sum(g["winner"] == "crew" for g in games) / n,
+           "rounds": _mean(g["rounds"] for g in games),
+           "last_vote_round": {str(k): sum(g["round"] == k for g in games) for k in sorted({g["round"] for g in games})},
+           "game": {k: getattr(cfg.game, k) for k in ("hide_roles", "clue_recipients", "clue_recipients_spread",
+                                                      "clue_round_pct", "clue_strength", "sabotage_target")}}
+    return out
+
+
+def in_band(x: float) -> bool:
+    return BAND[0] <= x <= BAND[1]
+
+
+def d1_walk(raw: dict, seeds=None, echo=print) -> dict:
+    """Walk the grid from most clues to fewest; the first setting whose mean error is in the band
+    is the density. Every setting is played and reported, so the reader sees the whole curve; the
+    choice is the walk's. Also today's rules on the same seeds, for the "solves it" share."""
+    seeds = list(seeds if seeds is not None else range(D1_SEEDS[0], D1_SEEDS[1] + 1))
+    today = d1_cell(raw, TODAY, seeds)
+    echo(_d1_line("today", "today's rules: roles revealed, 2 to 4 players every round", today))
+    cells, chosen = [], None
+    for key, label, over in GRID:
+        st = d1_cell(raw, dict(over, hide_roles=True), seeds)
+        st.update(key=key, label=label, overrides=dict(over, hide_roles=True), in_band=in_band(st["brier"]))
+        if chosen is None and st["in_band"]:
+            chosen = key
+        cells.append(st)
+        echo(_d1_line(key, label, st) + ("   <- in the band" if st["in_band"] else ""))
+    pick = next((c for c in cells if c["key"] == chosen), None)
+    return {"seeds": [seeds[0], seeds[-1]], "n_seeds": len(seeds), "bots": dict(BOT_POLICY), "band": list(BAND),
+            "solved_mark": SOLVED_MARK, "today": today, "grid": cells, "chosen": chosen,
+            "verdict": {"density_found": chosen is not None,
+                        "no_longer_solves": bool(pick and pick["solved"] < SOLVED_MARK),
+                        "pass": bool(pick and pick["solved"] < SOLVED_MARK)}}
+
+
+def _ci(ci) -> str:
+    return f"[{ci[0]:.3f}, {ci[1]:.3f}]" if ci else "-"
+
+
+def _d1_line(key: str, label: str, st: dict) -> str:
+    return (f"{key:<6} {label:<58} games {st['games']:>3}  error {st['brier']:.4f} {_ci(st['brier_ci'])}  "
+            f"top two = moles {100 * st['solved']:5.1f}%  crew win {100 * st['crew_win']:5.1f}%")
+
+
+def d1_markdown(res: dict) -> str:
+    t = res["today"]
+    L = [f"D1, scripted tuning: {res['n_seeds']} scripted-player games per setting, seeds {res['seeds'][0]} to "
+         f"{res['seeds'][1]}; crew `{res['bots']['crew']}` skill {res['bots']['crew_skill']}, moles "
+         f"`{res['bots']['moles']}`, mole cards `{res['bots']['mole_cards']}`. Zero model calls.", "",
+         "Error = mean `probes.brier` of the blind `jobw50` formula over the crew voters at the last vote of "
+         "each game, then the mean over games. 95% interval: bootstrap over games, 2,000 draws, seed 20261110. "
+         f"Band: {res['band'][0]} to {res['band'][1]}.", "",
+         "| Setting | Clues | Games | Crew voters | Formula's error | 95% interval | In band | Top two = the two moles "
+         "(share of crew voters, mean over games) | 95% interval | all crew voters | any crew voter | public view | "
+         "Crew wins |", "|---|---|---|---|---|---|---|---|---|---|---|---|---|"]
+
+    def row(key, label, st, band):
+        return (f"| {key} | {label} | {st['games']} | {st['voters']} | {st['brier']:.4f} | {_ci(st['brier_ci'])} | "
+                f"{band} | {100 * st['solved']:.1f}% | [{100 * st['solved_ci'][0]:.1f}%, {100 * st['solved_ci'][1]:.1f}%] | "
+                f"{100 * st['solved_all']:.1f}% | {100 * st['solved_any']:.1f}% | {100 * st['solved_public']:.1f}% | "
+                f"{100 * st['crew_win']:.1f}% |")
+    L.append(row("today", "today's rules (roles revealed; 2 to 4 players, every round)", t, "n/a"))
+    for c in res["grid"]:
+        L.append(row(c["key"], c["label"] + ", roles hidden", c, "**yes**" if c["in_band"] else "no"))
+    L.append("")
+    if res["chosen"]:
+        c = next(x for x in res["grid"] if x["key"] == res["chosen"])
+        L.append(f"First setting in the band, walking from most clues to fewest: **{c['key']}** ({c['label']}), "
+                 f"error {c['brier']:.4f}. Top two = the two moles: {100 * c['solved']:.1f}% there, "
+                 f"{100 * t['solved']:.1f}% under today's rules (mark: under {100 * res['solved_mark']:.0f}%).")
+    else:
+        L.append("**No setting on the grid lands in the band.**")
+    return "\n".join(L) + "\n"
+
+
+# --------------------------------------------------------------------------- D2: talk features
+
+def _words(text: str) -> int:
+    return len((text or "").split())
+
+
+def talk_features(view: list[dict], viewer: str, target: str, rnd: int, alive: list[str], f: dict,
+                  base_rate: float) -> dict:
+    """The talk features for one (viewer, target) pair at the viewer's vote turn in round `rnd`.
+
+    `view` is the viewer's own projected view of the masked record up to the vote cutoff, so every
+    feature is something that player could see at the table. `f` is the viewer's masked `jobw50`
+    for the other players still in. Definitions: docs/DETECT_RULES.md, section 5."""
+    disc = [e for e in view if e["type"] == "turn" and e.get("turn_phase") == "discuss"]
+    now = [e for e in disc if e["round"] == rnd]
+    mine = [e for e in now if e["player"] == target]
+    others_now = [e for e in now if e["player"] not in (viewer, target)]
+    act = lambda e: e.get("action") or {}                                           # noqa: E731
+    # accusations
+    accusers = {e["player"] for e in others_now if act(e).get("accuse") == target}
+    denom = max(1, len(alive) - 2)
+    before = {(e["round"], e["player"]) for e in disc
+              if e["round"] < rnd and e["player"] != viewer and act(e).get("accuse") == target}
+    past = max(0, rnd - 1)
+    votes_before = sum(1 for e in view if e["type"] == "vote_result" and e["round"] < rnd
+                       for voter, tgt in (e.get("votes") or {}).items() if tgt == target and voter != viewer)
+    # statements of the target called out this round by somebody other than the viewer
+    own_ids = {e.get("statement_id") for e in view if e["type"] == "turn" and e["round"] == rnd
+               and e.get("player") == target and e.get("statement_id")}
+    challenged = sum(1 for e in now if e["player"] not in (viewer, target)
+                     for sid in act(e).get("challenges") or [] if sid in own_ids)
+    # where the target points
+    accused = [act(e).get("accuse") for e in mine if act(e).get("accuse") not in (None, "none")]
+    if not accused:
+        target_f = base_rate
+    elif accused[-1] == viewer:
+        target_f = 0.0
+    else:
+        target_f = f.get(accused[-1], base_rate)
+    # formal claims
+    pick = next((e for e in reversed(view) if e["type"] == "job_pick" and e["round"] == rnd), None)
+    on_team = bool(pick and target in pick["team"])
+    claims = [act(e).get("job_claim") for e in mine]
+    helped = on_team and "helped" in claims
+    silent = on_team and not any(c in ("helped", "sabotaged") for c in claims)
+    name = re.compile(r"(?<!\w)" + re.escape(target) + r"(?!\w)")
+    wp = next((e for e in view if e["type"] == "whisper_pairs" and e["round"] == rnd), None)
+    return {
+        "acc_now": len(accusers) / denom,
+        "acc_before": len(before) / past if past else 0.0,
+        "votes_before": votes_before / past if past else 0.0,
+        "challenged_now": float(challenged),
+        "accuses_viewer": float(any(a == viewer for a in accused)),
+        "target_f": float(target_f),
+        "cards_now": float(sum(len(act(e).get("clue_cards") or []) for e in mine)),
+        "claim_helped": float(helped),
+        "claim_silent": float(silent),
+        "words_now": sum(_words(e.get("public")) for e in mine) / 100.0,
+        "mentions_now": (sum(1 for e in others_now if name.search(e.get("public") or "")) / len(others_now)
+                         if others_now else 0.0),
+        "whispered": float(bool(wp and any(target in pair for pair in wp["pairs"]))),
+    }
+
+
+def logit(p: float) -> float:
+    p = min(CLIP[1], max(CLIP[0], p))
+    return math.log(p / (1 - p))
+
+
+def reader_rows(events: list[dict], game: str, group: str | None = None) -> list[dict]:
+    """One row per (crew vote turn that was not a fallback, rated player) of a finished game, with
+    the record masked to the blind rules: the masked formula's chance, the features, the truth."""
+    masked = mask_blind(events)
+    start = start_of(masked)
+    role = roles_of(masked)
+    n_players = len(start["players"])
+    base = start["config"]["game"].get("num_moles", 2) / (n_players - 1)
+    rows = []
+    for t in crew_vote_turns(masked):
+        if t.get("fallback"):
+            continue
+        v, r = t["player"], t["round"]
+        alive = alive_at(masked, r)
+        rated = [n for n in alive if n != v]
+        cutoff = vote_cutoff(masked, r)
+        f = formulas(masked, cutoff, v, rated)["jobw50"]
+        view = visible_events([e for e in masked if e["seq"] <= cutoff], v)
+        for x in rated:
+            feats = talk_features(view, v, x, r, alive, f, base)
+            rows.append({"game": game, "group": group or game, "turn": (game, t["seq"]), "round": r, "viewer": v,
+                         "target": x, "f": f[x], "y": int(role[x] == "mole"),
+                         "x": [logit(f[x])] + [feats[k] for k in TALK_FEATURES]})
+    return rows
+
+
+# --------------------------------------------------------------------------- D2: the reader
+
+def _solve(a: list[list[float]], b: list[float]) -> list[float]:
+    """Solve a x = b by Gaussian elimination with partial pivoting (a is small and positive definite)."""
+    n = len(b)
+    m = [row[:] + [b[i]] for i, row in enumerate(a)]
+    for c in range(n):
+        piv = max(range(c, n), key=lambda i: abs(m[i][c]))
+        m[c], m[piv] = m[piv], m[c]
+        d = m[c][c]
+        for i in range(c + 1, n):
+            k = m[i][c] / d
+            if k:
+                for j in range(c, n + 1):
+                    m[i][j] -= k * m[c][j]
+    x = [0.0] * n
+    for i in range(n - 1, -1, -1):
+        x[i] = (m[i][n] - sum(m[i][j] * x[j] for j in range(i + 1, n))) / m[i][i]
+    return x
+
+
+def _sigmoid(z: float) -> float:
+    if z >= 0:
+        return 1 / (1 + math.exp(-z))
+    e = math.exp(z)
+    return e / (1 + e)
+
+
+def fit_logistic(X: list[list[float]], y: list[int], l2: float = L2) -> dict:
+    """Ridge logistic regression by Newton's method, standard library only.
+
+    Columns are standardised with the training mean and standard deviation (a constant column is
+    dropped: its coefficient is 0). The penalty `l2 / 2 * sum(b_j^2)` is on the standardised
+    coefficients, not on the intercept. Each step is halved until the penalised loss does not rise."""
+    n, k = len(X), len(X[0])
+    mu = [sum(r[j] for r in X) / n for j in range(k)]
+    sd = [math.sqrt(sum((r[j] - mu[j]) ** 2 for r in X) / n) for j in range(k)]
+    keep = [j for j in range(k) if sd[j] > 1e-12]
+    Z = [[1.0] + [(r[j] - mu[j]) / sd[j] for j in keep] for r in X]
+    d = len(keep) + 1
+    b = [0.0] * d
+
+    def loss(bb):
+        tot = 0.0
+        for z, yi in zip(Z, y):
+            s = sum(u * w for u, w in zip(z, bb))
+            tot += (max(s, 0) + math.log1p(math.exp(-abs(s)))) - yi * s
+        return tot + 0.5 * l2 * sum(w * w for w in bb[1:])
+
+    cur = loss(b)
+    for _ in range(NEWTON_STEPS):
+        g = [0.0] * d
+        H = [[0.0] * d for _ in range(d)]
+        for z, yi in zip(Z, y):
+            p = _sigmoid(sum(u * w for u, w in zip(z, b)))
+            w = p * (1 - p)
+            for i in range(d):
+                g[i] += (p - yi) * z[i]
+                zi = z[i] * w
+                Hi = H[i]
+                for j in range(i, d):
+                    Hi[j] += zi * z[j]
+        for i in range(d):
+            for j in range(i):
+                H[i][j] = H[j][i]
+        for i in range(1, d):
+            g[i] += l2 * b[i]
+            H[i][i] += l2
+        H[0][0] += 1e-9
+        step = _solve(H, g)
+        t = 1.0
+        while True:
+            nb = [w - t * s for w, s in zip(b, step)]
+            new = loss(nb)
+            if new <= cur + 1e-12 or t < 1e-6:
+                break
+            t /= 2
+        moved = max(abs(w - v) for w, v in zip(nb, b))
+        b, cur = nb, new
+        if moved < NEWTON_TOL:
+            break
+    return {"intercept": b[0], "coef": {j: b[i + 1] for i, j in enumerate(keep)}, "mu": mu, "sd": sd, "k": k}
+
+
+def predict(model: dict, x: list[float]) -> float:
+    s = model["intercept"]
+    for j, w in model["coef"].items():
+        s += w * (x[j] - model["mu"][j]) / model["sd"][j]
+    return _sigmoid(s)
+
+
+def leave_one_out(rows: list[dict], cols: list[int], group_key: str = "game") -> dict:
+    """Held-out chance for every row: the reader fitted on the rows of every other group."""
+    groups = sorted({r[group_key] for r in rows})
+    pred = {}
+    for g in groups:
+        train = [r for r in rows if r[group_key] != g]
+        model = fit_logistic([[r["x"][c] for c in cols] for r in train], [r["y"] for r in train])
+        for i, r in enumerate(rows):
+            if r[group_key] == g:
+                pred[i] = predict(model, [r["x"][c] for c in cols])
+    return pred
+
+
+def turn_errors(rows: list[dict], pred: dict) -> list[dict]:
+    """Per vote turn: the formula's error and the reader's, each the mean over the rated players of
+    (chance - truth)^2, as `probes.brier`."""
+    by: dict = {}
+    for i, r in enumerate(rows):
+        by.setdefault(r["turn"], []).append((r, pred[i]))
+    out = []
+    for turn, items in by.items():
+        r0 = items[0][0]
+        out.append({"turn": turn, "game": r0["game"], "group": r0["group"], "round": r0["round"],
+                    "formula": sum((r["f"] - r["y"]) ** 2 for r, _ in items) / len(items),
+                    "reader": sum((p - r["y"]) ** 2 for r, p in items) / len(items)})
+    return out
+
+
+def gain(turns: list[dict], a: str = "formula", b: str = "reader", unit: str = "game") -> dict:
+    """Mean of (error a - error b) over vote turns (above zero: b is better), with the bootstrap
+    interval over `unit` (2,000 draws, seed 20261110) and the paired t over the unit means."""
+    s = paired([(t[unit], t[a] - t[b]) for t in turns])
+    return {"turns": s["n"], "units": s["games"], "mean": s["mean"], "boot": s["boot"], "t": s["t"],
+            "a": _mean(t[a] for t in turns), "b": _mean(t[b] for t in turns)}
+
+
+def d2_evaluate(rows: list[dict]) -> dict:
+    """The whole D2 test on prepared rows. Nothing here looks at a result to choose anything."""
+    k = len(READER_FEATURES)
+    full = turn_errors(rows, leave_one_out(rows, list(range(k)), "game"))
+    only = turn_errors(rows, leave_one_out(rows, [0], "game"))
+    by_turn = {t["turn"]: t for t in full}
+    for t in only:
+        by_turn[t["turn"]]["formula_reader"] = t["reader"]
+    turns = list(by_turn.values())
+    seed_full = turn_errors(rows, leave_one_out(rows, list(range(k)), "group"))
+    primary = gain(turns)
+    control = gain(turns, "formula_reader", "reader")
+    recal = gain(turns, "formula", "formula_reader")
+    passed = bool(primary["mean"] >= MARGIN and primary["boot"] and primary["boot"][0] > 0)
+    talk = bool(control["boot"] and control["boot"][0] > 0)
+    model = fit_logistic([r["x"] for r in rows], [r["y"] for r in rows])
+    return {
+        "rows": len(rows), "turns": len(turns), "games": len({r["game"] for r in rows}),
+        "groups": len({r["group"] for r in rows}), "moles_share": _mean(r["y"] for r in rows),
+        "primary": primary, "pass": passed,
+        "control_talk_beyond_recalibration": control, "talk_shown": talk,
+        "recalibration_alone": recal,
+        "round1": gain([t for t in turns if t["round"] == 1]),
+        "round1_control": gain([t for t in turns if t["round"] == 1], "formula_reader", "reader"),
+        "round2plus": gain([t for t in turns if t["round"] >= 2]),
+        "round2plus_control": gain([t for t in turns if t["round"] >= 2], "formula_reader", "reader"),
+        "leave_one_seed_out": gain(seed_full, unit="group"),
+        "all_data_fit": {"intercept": model["intercept"],
+                         "coef": {READER_FEATURES[j]: w for j, w in model["coef"].items()}},
+        "turn_rows": turns,
+    }
+
+
+def _gain_line(name: str, g: dict) -> str:
+    if not g["turns"]:
+        return f"| {name} | 0 | 0 | - | - | - | - | - |"
+    t = f"{g['t'][0]:+.4f} [{g['t'][1]:+.4f}, {g['t'][2]:+.4f}]" if g["t"] else "-"
+    boot = f"[{g['boot'][0]:+.4f}, {g['boot'][1]:+.4f}]" if g["boot"] else "-"
+    return (f"| {name} | {g['turns']} | {g['units']} | {g['a']:.4f} | {g['b']:.4f} | {g['mean']:+.4f} | {boot} | {t} |")
+
+
+def d2_markdown(res: dict, manifest: dict | None = None) -> str:
+    p = res["primary"]
+    L = [f"D2, does the talk carry signal: {res['games']} finished games, {res['turns']} crew vote turns, "
+         f"{res['rows']} ratings (share that are moles {res['moles_share']:.3f}). Record masked to the blind rules. "
+         "Zero model calls.", ""]
+    if manifest:
+        L += [f"Games: `{manifest['manifest']}` (sha256 `{manifest['sha256']}`).", ""]
+    L += ["Gain = first error minus second error, mean over vote turns; above zero means the second is better. "
+          "Interval: bootstrap over games (over seeds in the last row), 2,000 draws, seed 20261110; "
+          "the paired t over game means is beside it.", "",
+          "| Comparison | Vote turns | Games | First error | Second error | Gain | 95% interval (bootstrap) | "
+          "t: mean of game means [95%] |", "|---|---|---|---|---|---|---|---|",
+          _gain_line("**Mark: masked formula, then reader (formula + talk)**", p),
+          _gain_line("Control: formula-only reader, then reader (what the talk adds)", res["control_talk_beyond_recalibration"]),
+          _gain_line("Masked formula, then formula-only reader (recalibration alone)", res["recalibration_alone"]),
+          _gain_line("Round 1 only (nothing to mask): masked formula, then reader", res["round1"]),
+          _gain_line("Round 1 only: formula-only reader, then reader", res["round1_control"]),
+          _gain_line("Rounds 2 and later: masked formula, then reader", res["round2plus"]),
+          _gain_line("Rounds 2 and later: formula-only reader, then reader", res["round2plus_control"]),
+          _gain_line("Leave one seed out, interval over seeds: masked formula, then reader", res["leave_one_seed_out"]),
+          "",
+          f"Mark (ANALYSIS.md D2): gain at least {MARGIN} with an interval excluding zero: "
+          f"**{'PASS' if res['pass'] else 'FAIL'}**. Does the talk add to a recalibrated formula (control interval "
+          f"above zero): **{'yes' if res['talk_shown'] else 'no'}**.", "",
+          "Reader fitted on all the data (for reading only; every number above is held-out). Coefficients are per "
+          "standard deviation of the feature:", "", "| Feature | Coefficient |", "|---|---|",
+          f"| (intercept) | {res['all_data_fit']['intercept']:+.3f} |"]
+    for k in READER_FEATURES:
+        w = res["all_data_fit"]["coef"].get(k)
+        L.append(f"| {k} | {w:+.3f} |" if w is not None else f"| {k} | dropped (constant) |")
+    return "\n".join(L) + "\n"
+
+
+# --------------------------------------------------------------------------- D2: the games
+
+def sha256_file(path) -> str:
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def d2_game_rows(index_path, batches=D2_BATCHES) -> list[dict]:
+    """The finished games D2 uses, from an index file as it stood: rows of the named batches, rules
+    0.3, not spoiled; for a seed played more than once in a batch, the last row (as `report.load_batch`)."""
+    rows = []
+    with open(index_path, encoding="utf-8") as f:
+        for line in f:
+            if line.strip():
+                rows.append(json.loads(line))
+    latest: dict = {}
+    for r in rows:
+        if r.get("batch") in batches and r.get("rules_version") == "0.3" and not r.get("spoiled") and r.get("winner"):
+            latest[(r["batch"], r.get("seed"))] = r
+    return sorted(latest.values(), key=lambda r: (batches.index(r["batch"]), r.get("seed"), r["game_id"]))
+
+
+def build_manifest(index_path, games_dir, batches=D2_BATCHES) -> dict:
+    games = []
+    for r in d2_game_rows(index_path, batches):
+        path = Path(games_dir) / f"{r['game_id']}.jsonl"
+        games.append({"game_id": r["game_id"], "batch": r["batch"], "seed": r.get("seed"), "sha256": sha256_file(path)})
+    with open(index_path, encoding="utf-8") as f:
+        n_rows = sum(1 for line in f if line.strip())
+    return {"index_sha256": sha256_file(index_path), "index_rows": n_rows,
+            "batches": list(batches), "count": len(games), "games": games}
+
+
+def d2_run(manifest_path, games_dir) -> dict:
+    """Load the games named in the manifest (checking each file's hash), build the rows, evaluate."""
+    man = json.loads(Path(manifest_path).read_text(encoding="utf-8"))
+    rows = []
+    for g in man["games"]:
+        path = Path(games_dir) / f"{g['game_id']}.jsonl"
+        if sha256_file(path) != g["sha256"]:
+            raise ValueError(f"{path}: file differs from the manifest")
+        rows += reader_rows(read_log(path), g["game_id"], group=f"seed {g['seed']}")
+    res = d2_evaluate(rows)
+    res["manifest"] = {"manifest": str(Path(manifest_path).name), "sha256": sha256_file(manifest_path),
+                       "count": man["count"]}
+    return res
+
+
+# --------------------------------------------------------------------------- D3: the score
+
+def rules_key(events: list[dict]) -> str:
+    """The `[game]` table a game was played under, as one string: two games are only ever scored
+    together when this is equal."""
+    return json.dumps(start_of(events)["config"]["game"], sort_keys=True)
+
+
+def detect_rows(events: list[dict]) -> list[dict]:
+    """One row per crew vote turn of a new-rules game: the formula's error, the player's error
+    (from the suspicion numbers the engine logged) and their difference, on the same rated players.
+    A fallback turn has no reading of the player's own: it is returned with `fallback` true and
+    no errors, so it is counted and not scored."""
+    if not is_blind(events):
+        raise ValueError(f"{start_of(events).get('game_id')}: not a new-rules game (hide_roles is off); "
+                         "Detect is scored on new-rules games only")
+    gid = start_of(events)["game_id"]
+    rows = []
+    for t in crew_vote_turns(events):
+        base = {"game": gid, "seed": start_of(events).get("seed"), "round": t["round"], "seq": t["seq"],
+                "player": t["player"], "model": t.get("model"), "fallback": bool(t.get("fallback"))}
+        if t.get("fallback"):
+            rows.append(base)
+            continue
+        sus = t["action"]["suspicion"]
+        rated = [n for n in alive_at(events, t["round"]) if n != t["player"] and n in sus]
+        truth = truth_for(events, rated)
+        f = formula_at_vote(events, t, rated)
+        fe, me = brier(f, truth), brier(stated(rated, sus), truth)
+        rows.append(dict(base, rated=len(rated), formula=fe, player_error=me, detect=fe - me))
+    return rows
+
+
+def detect_score(games: list[list[dict]]) -> dict:
+    """Detect per model over new-rules games: mean of (formula's error - model's error) over the
+    model's crew vote turns, bootstrap interval over games (2,000 draws, seed 20261110), paired t
+    over game means beside it. "Beats the formula" only if the interval lies above zero. Refuses
+    a game that reveals roles, and refuses to pool games played under different `[game]` tables."""
+    keys = {rules_key(ev) for ev in games}
+    if len(keys) > 1:
+        raise ValueError(f"{len(keys)} different [game] tables among these games; score one rules setting at a time")
+    rows = [r for ev in games for r in detect_rows(ev)]
+    models = sorted({r["model"] for r in rows}, key=str)
+    out = {"games": len(games), "rules": json.loads(next(iter(keys))) if keys else None, "models": {}}
+    for m in models:
+        mine = [r for r in rows if r["model"] == m]
+        ok = [r for r in mine if not r["fallback"]]
+        s = paired([(r["game"], r["detect"]) for r in ok])
+        fb = (len(mine) - len(ok)) / len(mine) if mine else 0.0
+        scored = bool(ok) and fb <= FALLBACK_LIMIT
+        out["models"][str(m)] = {
+            "turns": len(ok), "fallback_turns": len(mine) - len(ok), "fallback_share": fb, "games": s["games"],
+            "scored": scored, "formula_error": _mean(r["formula"] for r in ok),
+            "model_error": _mean(r["player_error"] for r in ok), "detect": s["mean"], "boot": s["boot"], "t": s["t"],
+            "beats_formula": bool(scored and s["boot"] and s["boot"][0] > 0),
+            "worse_than_formula": bool(scored and s["boot"] and s["boot"][1] < 0)}
+    out["rows"] = rows
+    return out
+
+
+def detect_markdown(res: dict) -> str:
+    L = [f"Detect on {res['games']} new-rules game(s). Detect = the formula's error minus the model's error on the "
+         "same crew vote turns (above zero: the model reads the table better than the formula). Interval: bootstrap "
+         "over games, 2,000 draws, seed 20261110.", "",
+         "| Model | Vote turns | Games | Fallback turns | Formula's error | Model's error | Detect | 95% interval | "
+         "t: mean of game means [95%] | Verdict |", "|---|---|---|---|---|---|---|---|---|---|"]
+    for m, s in res["models"].items():
+        if not s["turns"]:
+            L.append(f"| {m} | 0 | 0 | {s['fallback_turns']} | - | - | - | - | - | not scored |")
+            continue
+        boot = f"[{s['boot'][0]:+.4f}, {s['boot'][1]:+.4f}]" if s["boot"] else "-"
+        t = f"{s['t'][0]:+.4f} [{s['t'][1]:+.4f}, {s['t'][2]:+.4f}]" if s["t"] else "-"
+        verdict = ("not scored (no valid answer on more than 5% of its vote turns)" if not s["scored"] else
+                   "beats the formula" if s["beats_formula"] else
+                   "worse than the formula" if s["worse_than_formula"] else "not separated from the formula")
+        L.append(f"| {m} | {s['turns']} | {s['games']} | {s['fallback_turns']} | {s['formula_error']:.4f} | "
+                 f"{s['model_error']:.4f} | {s['detect']:+.4f} | {boot} | {t} | {verdict} |")
+    return "\n".join(L) + "\n"
+
+
+def load_new_rules_games(games_dir, batch: str) -> list[list[dict]]:
+    """The finished, unspoiled games of a batch (through `<games_dir>/index.jsonl`)."""
+    from .report import load_batch
+    logs = load_batch(games_dir, batch)
+    if not logs.known:
+        raise ValueError(f"no batch named {batch!r} in {Path(games_dir) / 'index.jsonl'}")
+    return list(logs.games)
+
+
+# --------------------------------------------------------------------------- commands
+
+def _write(out_dir, name: str, text: str):
+    out = Path(out_dir)
+    out.mkdir(parents=True, exist_ok=True)
+    (out / name).write_text(text, encoding="utf-8")
+    print(f"wrote {out / name}", file=sys.stderr)
+
+
+def cmd_d1(args) -> int:
+    res = d1_walk(load_raw(args.config))
+    md = d1_markdown(res)
+    sys.stdout.write("\n" + md)
+    if args.out:
+        _write(args.out, "detect_d1.json", json.dumps(res, indent=1) + "\n")
+        _write(args.out, "detect_d1.md", md)
+    return 0
+
+
+def cmd_manifest(args) -> int:
+    man = build_manifest(args.index, args.games)
+    text = json.dumps(man, indent=1) + "\n"
+    if Path(args.out).exists():
+        print(f"manifest: {args.out} exists; a frozen list is never overwritten", file=sys.stderr)
+        return 2
+    Path(args.out).write_text(text, encoding="utf-8")
+    by = {}
+    for g in man["games"]:
+        by[g["batch"]] = by.get(g["batch"], 0) + 1
+    print(f"{man['count']} games: " + ", ".join(f"{b} {n}" for b, n in by.items()))
+    return 0
+
+
+def cmd_d2(args) -> int:
+    res = d2_run(args.manifest, args.games)
+    md = d2_markdown(res, res["manifest"])
+    sys.stdout.write(md)
+    if args.out:
+        slim = dict(res, turn_rows=[dict(t, turn=list(t["turn"])) for t in res["turn_rows"]])
+        _write(args.out, "detect_d2.json", json.dumps(slim, indent=1) + "\n")
+        _write(args.out, "detect_d2.md", md)
+    return 0
+
+
+def cmd_score(args) -> int:
+    try:
+        res = detect_score(load_new_rules_games(args.games, args.batch))
+    except ValueError as e:
+        print(f"score: {e}", file=sys.stderr)
+        return 2
+    sys.stdout.write(detect_markdown(res))
+    return 0
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(prog="python3.11 -m inside_job.detect",
+                                 description="Detect (Bench v2, Phase 6): no command here calls a model")
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    a = sub.add_parser("d1", help="scripted-player tuning down the clue-density grid")
+    a.add_argument("--config", default="config/headroom.toml")
+    a.add_argument("--out", default=None)
+    a.set_defaults(fn=cmd_d1)
+    a = sub.add_parser("manifest", help="freeze the list of finished games D2 uses")
+    a.add_argument("--index", required=True)
+    a.add_argument("--games", required=True)
+    a.add_argument("--out", required=True)
+    a.set_defaults(fn=cmd_manifest)
+    a = sub.add_parser("d2", help="the no-model reader on masked finished games")
+    a.add_argument("--manifest", default="docs/DETECT_D2_GAMES.json")
+    a.add_argument("--games", default="games")
+    a.add_argument("--out", default=None)
+    a.set_defaults(fn=cmd_d2)
+    a = sub.add_parser("score", help="Detect per model on a batch of new-rules games")
+    a.add_argument("--games", default="games")
+    a.add_argument("--batch", required=True)
+    a.set_defaults(fn=cmd_score)
+    args = ap.parse_args(argv)
+    return args.fn(args)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
